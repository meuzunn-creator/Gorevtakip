rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function d() { return request.resource.data; }
    function txt(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    match /users/{id} {
      allow read, delete: if true;
      allow create, update: if txt(d().name, 80) && d().role in ['staff', 'manager'];
    }
    match /tasks/{id} {
      allow read, delete: if true;
      allow create, update: if txt(d().title, 2000)
        && d().date is string && d().date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d().status in ['open', 'blocked', 'done']
        && txt(d().assigneeId, 200);
    }
    match /photos/{id} {
      allow read, delete: if true;
      allow create, update: if d().data is string && d().data.size() < 900000;
    }
    match /machines/{id} {
      allow read, delete: if true;
      allow create, update: if txt(d().name, 120);
    }
  }
}
